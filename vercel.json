{
  "version": 2,
  "installCommand": "echo 'Static deployment - skipping local hardware bridge dependencies'",
  "buildCommand": "",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/hub", "destination": "/hub.html" },
    { "source": "/keyboard", "destination": "/keyboard.html" },
    { "source": "/piu", "destination": "/piu.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
